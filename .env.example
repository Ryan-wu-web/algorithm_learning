# 复制本文件为 .env，再填写你的真实配置。
# 不要把真实 API Key 写进 .env.example，也不要提交 .env。

OPENAI_API_KEY=
OPENAI_BASE_URL=https://你的中转站域名/v1
OPENAI_MODEL=填写中转站支持的模型ID

# Day 04：模型调用可靠性配置（以下均可按需调整）
OPENAI_MAX_TOKENS=300
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=60
OPENAI_TOTAL_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=1
